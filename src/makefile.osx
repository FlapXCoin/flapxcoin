# macOS makefile for flapxd, with the libraries from Homebrew:
#
#   brew install boost openssl@3 berkeley-db@5 miniupnpc
#   make -f makefile.osx
#
# DEPSDIR is Homebrew's prefix (/opt/homebrew on Apple Silicon, /usr/local
# on Intel). The keg-only OpenSSL and Berkeley DB paths can be overridden.

CC ?= clang
CXX ?= clang++
DEPSDIR ?= $(shell brew --prefix 2>/dev/null || echo /usr/local)
OPENSSL_PREFIX ?= $(DEPSDIR)/opt/openssl@3
BDB_PREFIX ?= $(DEPSDIR)/opt/berkeley-db@5
BOOST_LIB_SUFFIX ?= -mt
USE_UPNP ?= 1

INCLUDEPATHS= \
 -I"$(CURDIR)" \
 -I"$(CURDIR)"/obj \
 -I"$(BDB_PREFIX)/include" \
 -I"$(OPENSSL_PREFIX)/include" \
 -I"$(DEPSDIR)/include"

LIBPATHS= \
 -L"$(BDB_PREFIX)/lib" \
 -L"$(OPENSSL_PREFIX)/lib" \
 -L"$(DEPSDIR)/lib"

LIBS= -dead_strip

# Static copies where Homebrew has them, so flapxd runs without Homebrew;
# boost_system is header-only in current Boost
LIBS += \
 $(BDB_PREFIX)/lib/libdb_cxx.a \
 $(DEPSDIR)/lib/libboost_filesystem$(BOOST_LIB_SUFFIX).a \
 $(DEPSDIR)/lib/libboost_program_options$(BOOST_LIB_SUFFIX).a \
 $(DEPSDIR)/lib/libboost_thread$(BOOST_LIB_SUFFIX).a \
 $(DEPSDIR)/lib/libboost_chrono$(BOOST_LIB_SUFFIX).a \
 $(OPENSSL_PREFIX)/lib/libssl.a \
 $(OPENSSL_PREFIX)/lib/libcrypto.a \
 -lz

DEFS=-DMAC_OSX -DMSG_NOSIGNAL=0 -DBOOST_SPIRIT_THREADSAFE -DUSE_IPV6 -DALLOW_BURN

ifneq ($(USE_UPNP), -)
 DEFS += -DUSE_UPNP=$(USE_UPNP) -DSTATICLIB -DMINIUPNP_STATICLIB
 LIBS += $(DEPSDIR)/lib/libminiupnpc.a
endif

CFLAGS = -O2 -Wall -Wextra -Wformat -Wformat-security -Wno-unused-parameter $(DEFS) $(INCLUDEPATHS)
xCXXFLAGS = -std=c++11 -pthread $(CFLAGS) $(CXXFLAGS)

OBJS= \
    obj/kernel.o \
    obj/stakereport.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/miner.o \
    obj/key.o \
    obj/db.o \
    obj/init.o \
    obj/keystore.o \
    obj/core.o \
    obj/main.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcblockchain.o \
    obj/rpcmining.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcrawtransaction.o \
    obj/rpcwallet.o \
    obj/script.o \
    obj/scrypt.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/hash.o \
    obj/noui.o \
    obj/chainparams.o

all: flapxd

LIBS += $(CURDIR)/leveldb/libleveldb.a $(CURDIR)/leveldb/libmemenv.a
DEFS += $(addprefix -I,$(CURDIR)/leveldb/include)
DEFS += $(addprefix -I,$(CURDIR)/leveldb/helpers)
OBJS += obj/txdb-leveldb.o
leveldb/libleveldb.a:
	@echo "Building LevelDB ..."; cd leveldb; $(MAKE) CC="$(CC)" CXX="$(CXX)" libleveldb.a libmemenv.a; cd ..;
obj/txdb-leveldb.o: leveldb/libleveldb.a

# auto-generated dependencies:
-include obj/*.P

obj/build.h: FORCE
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h
DEFS += -DHAVE_BUILD_INFO

obj/scrypt.o: scrypt.c
	$(CC) -c $(CFLAGS) -o $@ $<

obj/%.o: %.cpp
	$(CXX) -c $(xCXXFLAGS) -MMD -MF $(@:%.o=%.d) -o $@ $<
	@cp $(@:%.o=%.d) $(@:%.o=%.P); \
	  sed -e 's/#.*//' -e 's/^[^:]*: *//' -e 's/ *\\$$//' \
	      -e '/^$$/ d' -e 's/$$/ :/' < $(@:%.o=%.d) >> $(@:%.o=%.P); \
	  rm -f $(@:%.o=%.d)

flapxd: leveldb/libleveldb.a $(OBJS:obj/%=obj/%)
	$(CXX) $(xCXXFLAGS) -o $@ $(LIBPATHS) $(OBJS) $(LIBS)

clean:
	-rm -f flapxd
	-rm -f obj/*.o
	-rm -f obj/*.P
	-rm -f obj/build.h

FORCE:
