# Windows daemon (flapxd.exe), built in MSYS2 (MINGW64 or MINGW32) like the
# GUI wallet: Boost, OpenSSL and miniupnpc from MSYS2, Berkeley DB 5.3 built
# statically (pass BDB_INCLUDE_PATH / BDB_LIB_PATH). Links everything
# statically, so the .exe runs on its own.
#
#   make -f makefile.mingw BDB_INCLUDE_PATH=... BDB_LIB_PATH=...

USE_UPNP ?= 1
BOOST_LIB_SUFFIX ?= -mt
CC ?= gcc
CXX ?= g++

INCLUDEPATHS = $(addprefix -I,$(BOOST_INCLUDE_PATH) $(BDB_INCLUDE_PATH) $(OPENSSL_INCLUDE_PATH) $(MINIUPNPC_INCLUDE_PATH))
LIBPATHS = $(addprefix -L,$(BOOST_LIB_PATH) $(BDB_LIB_PATH) $(OPENSSL_LIB_PATH) $(MINIUPNPC_LIB_PATH))

# boost_system is header-only in current Boost (MSYS2 has no library for it)
LIBS = \
 -l boost_filesystem$(BOOST_LIB_SUFFIX) \
 -l boost_program_options$(BOOST_LIB_SUFFIX) \
 -l boost_thread$(BOOST_LIB_SUFFIX) \
 -l boost_chrono$(BOOST_LIB_SUFFIX) \
 -l db_cxx

DEFS=-DWIN32 -D_WINDOWS -D_MT -DBOOST_THREAD_USE_LIB -DBOOST_SPIRIT_THREADSAFE -DUSE_IPV6 \
 -DBOOST_THREAD_PROVIDES_GENERIC_SHARED_MUTEX_ON_WIN
#DEBUGFLAGS=-g
CFLAGS=-O2 -w $(DEBUGFLAGS) $(DEFS) $(INCLUDEPATHS)
CXXFLAGS_EXTRA=-std=c++11
LDFLAGS=-Wl,--dynamicbase -Wl,--nxcompat -static -static-libgcc -static-libstdc++

TESTDEFS = -DTEST_DATA_DIR=$(abspath test/data)

ifneq ($(USE_UPNP), -)
 LIBS += -l miniupnpc -l iphlpapi
 DEFS += -DSTATICLIB -DMINIUPNP_STATICLIB -DUSE_UPNP=$(USE_UPNP)
endif

LIBS += -l ssl -l crypto -l z
# -lgdi32 has to come after -lcrypto
LIBS += -l kernel32 -l user32 -l gdi32 -l comdlg32 -l winspool -l winmm -l shell32 -l comctl32 -l ole32 -l oleaut32 -l uuid -l rpcrt4 -l advapi32 -l ws2_32 -l mswsock -l shlwapi -l crypt32 -l bcrypt

# TODO: make the mingw builds smarter about dependencies, like the linux/osx builds are
HEADERS = $(wildcard *.h)

OBJS= \
    obj/kernel.o \
    obj/stakereport.o \
    obj/alert.o \
    obj/version.o \
    obj/checkpoints.o \
    obj/netbase.o \
    obj/addrman.o \
    obj/crypter.o \
    obj/miner.o \
    obj/key.o \
    obj/db.o \
    obj/init.o \
    obj/keystore.o \
    obj/core.o \
    obj/main.o \
    obj/net.o \
    obj/protocol.o \
    obj/bitcoinrpc.o \
    obj/rpcblockchain.o \
    obj/rpcmining.o \
    obj/rpcdump.o \
    obj/rpcnet.o \
    obj/rpcrawtransaction.o \
    obj/rpcwallet.o \
    obj/script.o \
    obj/scrypt.o \
    obj/sync.o \
    obj/util.o \
    obj/wallet.o \
    obj/walletdb.o \
    obj/hash.o \
    obj/noui.o \
    obj/chainparams.o


all: flapxd.exe

LIBS += $(CURDIR)/leveldb/libleveldb.a $(CURDIR)/leveldb/libmemenv.a
DEFS += $(addprefix -I,$(CURDIR)/leveldb/include)
DEFS += $(addprefix -I,$(CURDIR)/leveldb/helpers)
OBJS += obj/txdb-leveldb.o
leveldb/libleveldb.a:
	cd leveldb; $(MAKE) TARGET_OS=NATIVE_WINDOWS CC="$(CC)" CXX="$(CXX)" libleveldb.a libmemenv.a; cd ..
obj/txdb-leveldb.o: leveldb/libleveldb.a

obj/scrypt.o: scrypt.c
	$(CC) -c $(CFLAGS) -o $@ $^

obj/build.h: FORCE
	/bin/sh ../share/genbuild.sh obj/build.h
version.cpp: obj/build.h
DEFS += -DHAVE_BUILD_INFO -I$(CURDIR)/obj

obj/%.o: %.cpp $(HEADERS)
	$(CXX) -c $(CFLAGS) $(CXXFLAGS_EXTRA) -o $@ $<

flapxd.exe: leveldb/libleveldb.a $(OBJS:obj/%=obj/%)
	$(CXX) $(CFLAGS) $(LDFLAGS) -o $@ $(LIBPATHS) $(OBJS) $(LIBS)

TESTOBJS := $(patsubst test/%.cpp,obj-test/%.o,$(wildcard test/*.cpp))

obj-test/%.o: test/%.cpp $(HEADERS)
	g++ -c $(TESTDEFS) $(CFLAGS) -o $@ $<

test_flapx.exe: $(TESTOBJS) $(filter-out obj/init.o,$(OBJS:obj/%=obj/%))
	g++ $(CFLAGS) -o $@ $(LIBPATHS) $^ -lboost_unit_test_framework-mgw45-mt-d-1_53 $(LIBS)

clean:
	rm -f flapxd.exe test_flapx.exe
	rm -f obj/*.o
	rm -f obj-test/*.o
	rm -f obj/build.h

FORCE:
