/*
  FlapXCoin theme - the built-in default look of the FlapX wallet.

  Deep navy space with the FlapX moon-base picture behind the window, see-through
  panels framed in FlapX green, Flappy Bird yellow for highlights and the
  selected page, and bold white text throughout. The base colours also come
  from the theme table in GUIUtil (guiutil.cpp).

  The other dark built-in themes (Космос, Mars Colony, Synthwave, Deep Sea,
  Winter, DaGoofMan, Silverwing, Flappy Night, Terminal) use this same layout: each one's
  .qss holds only its own variables (and any extra rules), and the wallet adds
  everything below the variables. To make another space theme, copy this file
  to themes/<Name>/styles.qss next to the wallet (or in the data directory) and
  change the variables.
*/

/** [VARS]
@space = #0b1220
@space2 = #111a2e
@panel = #15203a
@glass = rgba(14, 22, 40, 150)
@alt = #172340
@border = #24345a
@frame = #2fbf71
@accent = #fcd535
@accent2 = #22f07a
@tint = 252, 213, 53
@tint2 = 34, 240, 122
@btn1 = #fcd535
@btn2 = #22f07a
@btn1light = #fde27a
@btn2light = #6cf5a8
@onbtn = #0b1220
@title1 = #1a3550
@title2 = #13263d
@ontitle = #ffffff
@text = #ffffff
@muted = #a9b6cc
@track = #8fa3bf
@statusbg = #070c17
@total = #fcd535
@interest = #22f07a
@danger = #ff6b81
[/VARS] */

/* ---------- all text: bold ---------- */

* {
    font-weight: bold;
}

/* ---------- window, menus ---------- */

/* The window background (navy + starfield) comes from the palette, so it isn't set here */
QMainWindow, QDialog {
    color: @text;
}

QMenuBar {
    background-color: @space2;
    color: @text;
    border-bottom: 1px solid @border;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: rgba(@tint, 30);
    color: @accent;
}

QMenu {
    background-color: @panel;
    color: @text;
    border: 1px solid @border;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(@tint, 35);
    color: @accent;
}

QMenu::separator {
    height: 1px;
    background: @border;
    margin: 4px 8px;
}

/* ---------- toolbar (page buttons) ---------- */

QToolBar {
    background-color: @space;
    border: none;
    border-bottom: 1px solid @border;
    padding: 3px 2px;
    spacing: 0px;
}

QToolBar QToolButton {
    color: @text;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 4px 5px 4px 3px;
    margin: 0px;
}

QToolBar QToolButton:hover {
    background-color: rgba(@tint, 20);
    color: @accent;
}

QToolBar QToolButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(@tint, 56), stop:1 rgba(@tint2, 31));
    border: 1px solid @accent;
    color: @text;
    font-weight: bold;
}

/* ---------- panels ---------- */

QGroupBox {
    background-color: @glass;
    border: 1px solid @frame;
    border-radius: 10px;
    margin-top: 14px;
    padding: 18px 10px 8px 10px;
    color: @text;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 3px 10px;
    color: @ontitle;
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @title1, stop:1 @title2);
    border: 1px solid @frame;
    border-radius: 6px;
}

QGroupBox QLabel {
    color: @text;
}

QLabel {
    color: @text;
    background: transparent;
}

QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: @border;
}

/* ---------- overview page ---------- */

QLabel#labelOverviewTitle {
    color: @text;
}

QGroupBox QLabel#labelBalance, QGroupBox QLabel#labelStake, QGroupBox QLabel#labelUnconfirmed,
QGroupBox QLabel#labelImmature, QGroupBox QLabel#heightBox, QGroupBox QLabel#rewardBox,
QGroupBox QLabel#volumeBox, QGroupBox QLabel#diffBox, QGroupBox QLabel#diffBox2,
QGroupBox QLabel#pawrateBox, QGroupBox QLabel#connectionBox {
    color: @text;
    font-weight: bold;
}

QGroupBox QLabel#labelTotal {
    color: @total;
    font-weight: bold;
    font-size: 15px;
}

QGroupBox QLabel#labelInterest {
    color: @interest;
    font-weight: bold;
}

/* Staking status line */
QLabel#labelMyWeight {
    color: @text;
}

/* Mission Logs: the list of recent transactions sits straight on the panel */
QListView#listTransactions {
    background: transparent;
    border: none;
}

QLabel#labelAlerts {
    background-color: rgba(255, 107, 129, 30);
    color: @text;
    border: 1px solid @danger;
    border-radius: 6px;
    padding: 4px 8px;
}

QLabel#labelTransactionsStatus {
    color: @danger;
}

/* ---------- lists & tables ---------- */

QListView, QTableView, QTreeView {
    background-color: @panel;
    alternate-background-color: @alt;
    color: @text;
    border: 1px solid @border;
    border-radius: 8px;
    gridline-color: @border;
    selection-background-color: rgba(@tint, 50);
    selection-color: @text;
    outline: 0;
}

QListView::item:hover, QTableView::item:hover, QTreeView::item:hover {
    background-color: rgba(@tint, 20);
}

QHeaderView {
    background-color: @space2;
    border: none;
}

QHeaderView::section {
    background-color: @space2;
    color: @text;
    font-weight: bold;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid @border;
    border-bottom: 1px solid @accent;
}

QTableCornerButton::section {
    background-color: @space2;
    border: none;
}

/* ---------- inputs ---------- */

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background-color: @space2;
    color: @text;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 4px 6px;
    selection-background-color: rgba(@tint, 90);
    selection-color: @text;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    border: 1px solid @accent;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    color: @muted;
    background-color: @space;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: @panel;
    color: @text;
    border: 1px solid @border;
    selection-background-color: rgba(@tint, 50);
    selection-color: @text;
}

/* ---------- buttons ---------- */

QPushButton {
    background-color: transparent;
    color: @text;
    border: 1px solid @accent;
    border-radius: 7px;
    padding: 6px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(@tint, 30);
    color: @text;
}

QPushButton:pressed {
    background-color: rgba(@tint, 60);
}

QPushButton:disabled {
    color: @muted;
    border-color: @border;
}

/* Main buttons (OK, Send): the theme gradient. Multisend on the overview is a
   plain framed button like Lock/Unlock. */
QPushButton:default, QPushButton#sendButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @btn1, stop:1 @btn2);
    color: @onbtn;
    border: none;
}

QPushButton:default:hover:hover, QPushButton#sendButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @btn1light, stop:1 @btn2light);
    color: @onbtn;
}

QPushButton:default:disabled:disabled, QPushButton#sendButton:disabled {
    background-color: @border;
    color: @muted;
}

QToolButton {
    color: @text;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px;
}

QToolButton:hover {
    border: 1px solid @border;
    background-color: rgba(@tint, 20);
}

/* ---------- tabs ---------- */

QTabWidget::pane {
    background-color: @panel;
    border: 1px solid @border;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: @space2;
    color: @text;
    border: 1px solid @border;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: @panel;
    color: @accent;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    color: @accent;
}

/* ---------- check boxes & radio buttons ---------- */

QCheckBox, QRadioButton {
    color: @text;
    spacing: 6px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background-color: @space2;
    border: 1px solid @border;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: @accent;
    border: 1px solid @accent;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid @accent;
}

/* ---------- status bar & progress ---------- */

QStatusBar {
    background-color: @statusbg;
    color: @text;
    border-top: 1px solid @border;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: @text;
}

/* Sync bar: dark bold text, readable on both the gradient and the steel track */
QProgressBar {
    background-color: @track;
    color: #000000;
    border: 1px solid @border;
    border-radius: 6px;
    text-align: center;
    font-weight: bold;
    min-height: 20px;
    min-width: 260px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent, stop:1 @accent2);
    border-radius: 4px;
}

/* ---------- scroll bars ---------- */

QScrollBar:vertical {
    background: @space;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background: @space;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: @border;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: @accent;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ---------- tooltips & splitters ---------- */

QToolTip {
    background-color: @space2;
    color: @text;
    border: 1px solid @accent;
    padding: 4px;
}

QSplitter::handle {
    background-color: @border;
}

/* ---------- debug window ---------- */

QLabel#trafficNote {
    color: @muted;
}

/* ---------- message boxes ---------- */

QMessageBox QLabel {
    color: @text;
}
